# ─── Database ────────────────────────────────────────────────────────────────
# Local development (relative to prisma/schema.prisma -> prisma/dev.db)
DATABASE_URL="file:./dev.db"
# Production on Fly.io (persistent volume mounted at /data) — set in fly.toml:
# DATABASE_URL="file:/data/buyur.db"

# ─── Time zone (all "today / overdue" logic uses the server zone) ────────────
TZ="Europe/Istanbul"

# ─── First boot (production) ─────────────────────────────────────────────────
# When the database has no users, the boot script creates this admin.
# Set with `fly secrets set` — never commit real values.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"

# Load demo data on first boot when the database is empty (true/false)
SEED_ON_EMPTY="false"
